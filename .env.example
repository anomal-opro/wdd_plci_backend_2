# PORT SERVER
PORT=5000

# MONGODB CONNECTION STRING
# Contoh: mongodb+srv://<username>:<password>@cluster0.mongodb.net/plci_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/plci_kantin_smb?retryWrites=true&w=majority

# DEFAULT TARGET BRANCH
DEFAULT_SHEET=PLCI Kantin SMB

# OPTIONAL: TELEGRAM EMERGENCY ALERT BOT
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
